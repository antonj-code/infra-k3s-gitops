      ]
    },
    {
      "id": 202,
      "type": "row",
      "title": "The apps",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "App pods ready",
      "description": "Single-replica apps on Longhorn restart once per node move. A dip here is a restart, not data loss - pair it with the 7-day history panel in the post.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1.2,
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "palette-classic"
