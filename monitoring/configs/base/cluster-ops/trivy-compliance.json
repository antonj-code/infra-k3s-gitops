          }
        }
      }
    },
    {
      "type": "row",
      "title": "RBAC Security Risks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "stat",
      "title": "ClusterRole Risks (Critical & High)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "sum(trivy_clusterrole_clusterrbacassessments{name!~\".*(flux-system|longhorn|kube-prometheus).*\",severity=~\"Critical|High\"}) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "type": "stat",
