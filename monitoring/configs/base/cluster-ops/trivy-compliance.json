        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "expr": "sum(trivy_resource_configaudits{namespace!~\"longhorn-system|kube-system\",severity=\"Medium\"}) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
