{
  "title": "JNET Homelab - Trivy CIS Compliance",
  "uid": "jnet-k3s-trivy-compliance",
  "tags": ["security", "trivy", "cis", "compliance"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5m",
  "panels": [
    {
      "type": "stat",
      "title": "Passing Checks",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(trivy_cluster_compliance{status=\"Pass\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Failing Checks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(trivy_cluster_compliance{status=\"Fail\"})",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Compliance Breakdown by Benchmark",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (title, status) (trivy_cluster_compliance)",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{title}} ({{status}})"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    }
  ]
}
