      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "expr": "sum(trivy_role_rbacassessments{severity=~\"Critical|High\"}) or vector(0)",
          "refId": "A",
